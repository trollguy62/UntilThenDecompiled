[sub_resource type="Shader" id="521"]
code = "shader_type spatial;
render_mode depth_prepass_alpha, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color = vec4(1.0f);
uniform sampler2D texture_albedo : source_color;
uniform float alpha_scissor : hint_range(0, 1) = 1.0f;

uniform sampler2D texture_normal : hint_normal;
uniform float normal_depth = 1.0f;
uniform bool normal_linear_sampling = false;

uniform float metallic : hint_range(0, 1) = 0.0f;
uniform float roughness : hint_range(0, 1) = 1.0f;
uniform float specular : hint_range(0, 1) = 0.5f;
uniform sampler2D texture_roughness_metallic : hint_default_white;

uniform sampler2D texture_wet : hint_default_black;
uniform float wet_metallic : hint_range(0, 1) = 0.5;
uniform bool wet_linear_sampling = false;

uniform sampler2D texture_albedo_interior : source_color;
uniform vec4 interior_light_color_1 : source_color = vec4(1);
uniform vec4 interior_light_color_2 : source_color = vec4(1);

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

vec2 lissajous(float x, float fx, float fy) {
	return vec2(sin(fx * x), sin(fy * x)) * vec2(0.5) + vec2(0.5);
}

float interiorLight(float t, vec2 uv, float fx, float fy) {
	vec2 p = mix(vec2(0.6, 0.1), vec2(0.9, 0.3), lissajous(t, fx, fy));
	return pow(1. - clamp(length(uv - p) * 2., 0., 1.), 16.);
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(texture_albedo, 0));

	vec4 albedo_tex = texturePointSmooth(texture_albedo, UV, px_size);
	vec4 albedo_interior_tex = texturePointSmooth(texture_albedo_interior, UV, px_size);
	vec4 wet_tex = wet_linear_sampling
		? texture(texture_wet, UV)
		: texturePointSmooth(texture_wet, UV, px_size);

	vec4 albedo_final = albedo * albedo_tex;
	float window = step(0.999, albedo_final.g);

	ALBEDO = mix(
		albedo_final.rgb,
		albedo_interior_tex.rgb,
		window
	);
	ALPHA = albedo_final.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor;

	vec2 roughness_metallic_tex = texturePointSmooth(texture_roughness_metallic, UV, px_size).rg;
	ROUGHNESS = roughness_metallic_tex.r * roughness * mix(1.0, 0.0, wet_tex.r);
	METALLIC = mix(roughness_metallic_tex.g * metallic, wet_metallic, wet_tex.r);

	NORMAL_MAP = normal_linear_sampling
		? texture(texture_normal, UV).rgb
		: texturePointSmooth(texture_normal, UV, px_size).rgb;
	NORMAL_MAP_DEPTH = normal_depth * (1.0 - wet_tex.g);
	SPECULAR = specular;

	float L1 = interiorLight(TIME, UV, 2., 3.);
	float L2 = interiorLight(TIME + 0.23, UV, 4., 2.);
	vec3 L = clamp(
		(L1 * interior_light_color_1.rgb) + (L2 * interior_light_color_2.rgb),
		vec3(0),
		vec3(1)
	);
	EMISSION = (L * 0.5 + albedo_interior_tex.rgb * 0.2) * window;
}
"

