[sub_resource type="Shader" id="5"]
code = "shader_type spatial;

uniform sampler2D texture_albedo : source_color, repeat_disable;
uniform sampler2D texture_emission : hint_default_black, repeat_disable;
uniform sampler2D texture_normal : repeat_disable;
uniform float emission_energy : hint_range(0, 16) = 0.0;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(texture_albedo, 0));
	vec4 tex_albedo = texturePointSmooth(texture_albedo, UV, px_size);

	ALBEDO = tex_albedo.rgb;
	ALPHA = tex_albedo.a;
	ALPHA_SCISSOR_THRESHOLD = 0.01;
	NORMAL_MAP = texturePointSmooth(texture_normal, UV, px_size).rgb;

	if (UV.x < 0.46 || UV.x > 0.73 || mod(TIME, 2.0) < 1.0)
		EMISSION = texturePointSmooth(texture_emission, UV, px_size).rgb * emission_energy;
}"

