[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx, cull_disabled, depth_prepass_alpha;

uniform sampler2D texture_albedo : source_color;
uniform sampler2D texture_noise : hint_default_black;
uniform vec3 displacement = vec3(0.02, 0, 0.02);
uniform float speed = 1.0;
uniform float y_pow = 1.23;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

void vertex() {
	float noise = texture(texture_noise, vec2(TIME * speed)).r;
	noise = noise * 2.0 - 1.0;

	float factor = noise * pow((1. - UV.y), y_pow);
	vec3 global_displacement = vec3(factor) * displacement;
	VERTEX += (vec4(global_displacement, 1) * MODEL_MATRIX).xyz;
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(texture_albedo, 0));
	vec4 tex_albedo = texturePointSmooth(texture_albedo, UV, px_size);
	ALBEDO = tex_albedo.rgb;
	ALPHA = tex_albedo.a;
	ALPHA_SCISSOR_THRESHOLD = 1.0;
}
"

