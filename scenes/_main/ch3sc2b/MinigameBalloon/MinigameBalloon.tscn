[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform sampler2D tex : filter_nearest;
uniform bool flash = false;

void fragment() {
	vec4 c = texture(tex, UV);

	if (c.a > 0.5) {
		COLOR = flash ? vec4(1) : c;
	} else {
		COLOR = vec4(0);
	}
}
"

