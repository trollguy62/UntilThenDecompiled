[sub_resource type="Shader" id="Shader_hd6cp"]
code = "shader_type spatial;
render_mode cull_disabled;

uniform sampler2D tex_0 : source_color, hint_default_transparent;
uniform sampler2D tex_1 : source_color, hint_default_transparent;
uniform sampler2D tex_2 : source_color, hint_default_transparent;
uniform sampler2D tex_3 : source_color, hint_default_transparent;
uniform sampler2D tex_4 : source_color, hint_default_transparent;
uniform sampler2D tex_5 : source_color, hint_default_transparent;

instance uniform float wind_strength = 0.0f;

varying flat int inst_id;

#define TEXPS(smp, uv) texturePointSmooth(smp, uv, 1.0f / vec2(textureSize(smp, 0)));

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

mat4 rotationX( in float angle ) {
	mat4 M = mat4(1);
	M[1][1] = M[2][2] = cos(angle);
	M[2][1] = sin(angle);
	M[1][2] = -M[2][1];
	return M;
}

mat4 rotationY( in float angle ) {
	mat4 M = mat4(1);
	M[0][0] = M[2][2] = cos(angle);
	M[0][2] = sin(angle);
	M[2][0] = -M[0][2];
	return M;
}

mat4 rotationZ( in float angle ) {
	mat4 M = mat4(1);
	M[0][0] = M[1][1] = cos(angle);
	M[1][0] = sin(angle);
	M[0][1] = -M[1][0];
	return M;
}

float randf(float s) {
    return fract(sin(dot(vec2(s, s) ,vec2(12.9898,78.233))) * 43758.5453);
}

float rand_range(float s, float a, float b) {
	return randf(s) * (b - a) + a;
}

void vertex() {
	ivec2 px_size = ivec2(0);
	inst_id = INSTANCE_ID % 6;

	switch (inst_id) {
		case 0: px_size = textureSize(tex_0, 0); break;
		case 1: px_size = textureSize(tex_1, 0); break;
		case 2: px_size = textureSize(tex_2, 0); break;
		case 3: px_size = textureSize(tex_3, 0); break;
		case 4: px_size = textureSize(tex_4, 0); break;
		case 5: px_size = textureSize(tex_5, 0); break;
	}

	VERTEX.xy *= vec2(px_size) / vec2(100.0);

	float r1 = randf(float(inst_id) + MODELVIEW_MATRIX[0].x);
	float r2 = randf(r1);
	float r3 = randf(r2);

	mat4 rot = rotationY(pow(abs(sin(TIME * mix(0.8, 1.1, r1))), mix(100.0, 200.0, r2)) * 0.14 * r3 * wind_strength);
	VERTEX = (vec4(VERTEX, 1) * rot).xyz;
	NORMAL = (vec4(NORMAL, 1) * rot).xyz;
}

void fragment() {
	vec4 tex = vec4(0);
	vec2 uv = UV;

	switch (inst_id) {
		case 0: tex = TEXPS(tex_0, uv); break;
		case 1: tex = TEXPS(tex_1, uv); break;
		case 2: tex = TEXPS(tex_2, uv); break;
		case 3: tex = TEXPS(tex_3, uv); break;
		case 4: tex = TEXPS(tex_4, uv); break;
		case 5: tex = TEXPS(tex_5, uv); break;
	}

	ALBEDO = tex.rgb;
	ALPHA = tex.a;
	ALPHA_SCISSOR_THRESHOLD = 1.0;
}
"

