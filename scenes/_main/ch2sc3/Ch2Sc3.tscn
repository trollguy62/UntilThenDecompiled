[sub_resource type="Shader" id="10"]
code = "shader_type canvas_item;

uniform float barrelPower = 1.0;
uniform float multDecr = 0.0;
uniform vec4 modulate : source_color = vec4(1);
uniform sampler2D SCREEN_TEXTURE: hint_screen_texture, filter_linear_mipmap;

vec2 distort(vec2 p) {
    if (p.x > 0.0) {
		float angle = p.y / p.x;
		float theta = atan(angle);
		float radius = length(p);
		radius = pow(radius, barrelPower);

		p.x = radius * cos(theta);
		p.y = radius * sin(theta);
	} else {
		float angle = p.y / p.x;
		float theta = atan(angle);
		float radius = length(p);
		radius = pow(radius, barrelPower);

		p.y = radius * sin(-theta);
		p.x = radius * cos(theta);
		p.x = - p.x;
	}

	return 0.5 * (p + vec2(1.0,1.0));
}

vec4 chromaticAberration(sampler2D tex, vec2 uv, float inner_radius, float outer_radius, float strength) {
	vec2 centered = uv - vec2(0.5);
	float a = smoothstep(inner_radius, outer_radius, length(centered));

	vec4 c = texture(tex, uv);
	float offset = strength * a / 100.;
	c.r = texture(tex, uv + vec2(offset, 0)).r;
	c.b = texture(tex, uv - vec2(offset, 0)).b;
	return c;
}

float scanlines(vec2 uv, float freq, float t, float speed, float low, float high) {
	float c = sin(uv.y * freq + t * speed) / 2. + 0.5;
	return mix(low, high, c);
}

float rand(vec2 co){
    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
}

void fragment() {
	vec2 uv = distort((SCREEN_UV - vec2(0.4999)) * (2.0 - multDecr));

	vec4 scr = chromaticAberration(SCREEN_TEXTURE, uv, 0, 0.4, 0.25);

	float c = scanlines(uv, 1000., TIME, 30., 0.9, 1.0);

	vec2 kuv = floor(uv / 0.04);
	float k = rand(kuv + vec2(TIME) * 0.000001 * 0.2);
	k = mix(0.9, 1.0, k);

	c *= k;
	COLOR = scr * vec4(vec3(c), 1.0) * modulate;
}"

