[sub_resource type="Shader" id="9561"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0, 1) = 1.0;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

void fragment() {
	if (strength < 0.001) {
		COLOR = vec4(0);
	} else {
		vec2 size = 1.0 / vec2(textureSize(SCREEN_TEXTURE, 0));
		vec4 o = size.xyxy * vec2(-0.5, 0.5).xxyy * strength;
		vec4 s =
				texture(SCREEN_TEXTURE, SCREEN_UV + o.xy) +
				texture(SCREEN_TEXTURE, SCREEN_UV + o.zy) +
				texture(SCREEN_TEXTURE, SCREEN_UV + o.xw) +
				texture(SCREEN_TEXTURE, SCREEN_UV + o.zw);
		COLOR = vec4(s.rgb * 0.25, 1);
	}
}
"

