[sub_resource type="Shader" id="9366"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0, 4) = 1.0;
uniform float mul_rand_strength: hint_range(0, 2) = 1.0;
uniform sampler2D noise;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

const int kernelSampleCount = 22;
const highp vec2 kernel[22] = highp vec2[22] (
	vec2(0, 0),
	vec2(0.53333336, 0),
	vec2(0.3325279, 0.4169768),
	vec2(-0.11867785, 0.5199616),
	vec2(-0.48051673, 0.2314047),
	vec2(-0.48051673, -0.23140468),
	vec2(-0.11867763, -0.51996166),
	vec2(0.33252785, -0.4169769),
	vec2(1, 0),
	vec2(0.90096885, 0.43388376),
	vec2(0.6234898, 0.7818315),
	vec2(0.22252098, 0.9749279),
	vec2(-0.22252095, 0.9749279),
	vec2(-0.62349, 0.7818314),
	vec2(-0.90096885, 0.43388382),
	vec2(-1, 0),
	vec2(-0.90096885, -0.43388376),
	vec2(-0.6234896, -0.7818316),
	vec2(-0.22252055, -0.974928),
	vec2(0.2225215, -0.9749278),
	vec2(0.6234897, -0.7818316),
	vec2(0.90096885, -0.43388376)
);

void fragment() {
	if (strength < 0.001) {
		COLOR = vec4(0);
	} else {
		vec2 size = 1.0 / vec2(textureSize(SCREEN_TEXTURE, 0));
		float s = strength * (1.0 + mul_rand_strength * texture(noise, vec2(TIME * 0.2, 0)).r);

		vec3 color = vec3(0);
		for (int i = 0; i < kernelSampleCount; i++) {
			vec2 o = kernel[i] * size * 8.0 * s;
			vec2 uv = SCREEN_UV + o;
			color += texture(SCREEN_TEXTURE, uv).rgb;
		}

		color /= float(kernelSampleCount);
		COLOR = vec4(color, 1);
	}
}
"

