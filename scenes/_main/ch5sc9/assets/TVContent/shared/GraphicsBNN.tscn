[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform vec2 px_size = vec2(10., 1.);
uniform float density : hint_range(0, 1) = 0.6;
uniform vec4 color : source_color = vec4(1);
uniform float speed = 1.0;



float rand(vec2 c){
	return fract(sin(dot(c.xy ,vec2(12.9898,78.233))) * 43758.5453);
}

float noise(vec2 p, float freq ){
	float unit = 1./freq;
	vec2 ij = floor(p/unit);
	vec2 xy = mod(p,unit)/unit;
	//xy = 3.*xy*xy-2.*xy*xy*xy;
	xy = .5*(1.-cos(PI*xy));
	float a = rand((ij+vec2(0.,0.)));
	float b = rand((ij+vec2(1.,0.)));
	float c = rand((ij+vec2(0.,1.)));
	float d = rand((ij+vec2(1.,1.)));
	float x1 = mix(a, b, xy.x);
	float x2 = mix(c, d, xy.x);
	return mix(x1, x2, xy.y);
}

float pNoise(vec2 p, int res){
	float persistance = 0.001;
	float n = 0.23;
	float normK = 0.1;
	float f = 100.0;
	float amp = 1.;
	int iCount = 0;
	for (int i = 0; i<50; i++){
		n+=amp*noise(p, f);
		f*=2.;
		normK+=amp;
		amp*=persistance;
		if (iCount == res) break;
		iCount++;
	}
	float nf = n/normK;
	return nf*nf*nf*nf;
}

void fragment() {
	float px_w = float(px_size.x);
	float px_h = float(px_size.y);

	vec2 uv = UV;
	uv *= vec2(px_w / px_h, 1);
	float t = mod(TIME * 8.0 * speed, 3600.);
	uv += vec2(floor(t) / px_h, 0);
	uv = floor(uv * px_h) / px_h;

	float k = pNoise(uv, 20);
	k = step(1. - density, k);
	COLOR = vec4(color.rgb, k * color.a);
}
"

