[ext_resource type="Script" path="res://scenes/_main/ch10sc1c/scripts/RainLeak.gd" id="1_ulpwf"]

[sub_resource type="Shader" id="Shader_c2m8b"]
code = "shader_type spatial;

uniform vec4 albedo : source_color = vec4(1);
uniform float max_height = 1.0;

instance uniform float progress : hint_range(0.0, 1.0) = 0.0;

float f(float x) {
	float mean = 0.0;
	float sd = 0.14;
	float peak = 2.85;
	float e = -pow(x - mean, 2.0) / (2.0 * sd * sd);
	float fac = pow(progress, 0.4);
	return (1.0 / (sd * sqrt(2.0 * PI))) * pow(E, e) / peak * fac;
}

void vertex() {
	UV -= vec2(0.5);

	float r = length(UV);
	VERTEX.y = f(r) * max_height;

	// TODO: Compute NORMAL
}

void fragment() {
	ALBEDO = albedo.rgb;
	ALPHA = step(length(UV), 0.5) * albedo.a;

	ROUGHNESS = 0.02;
}
"

