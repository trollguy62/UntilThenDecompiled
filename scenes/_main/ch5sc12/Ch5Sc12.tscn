[sub_resource type="Shader" id="Shader_wl2ot"]
code = "shader_type canvas_item;

void fragment() {
	float fac = pow(1. - COLOR.g, 1.8);
	COLOR *= fac;
	COLOR.r *= pow(fac, 2.0) * 2.3;
}
"

