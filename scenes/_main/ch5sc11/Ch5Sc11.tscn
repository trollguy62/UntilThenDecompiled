[sub_resource type="Shader" id="692"]
code = "shader_type canvas_item;

uniform sampler2D input : source_color;
uniform int grid_size_samples = 4;

void fragment() {
	vec3 sum = vec3(0);
	float n = float(grid_size_samples + 1);

	for (int i = 1; i <= grid_size_samples; i++) {
		for (int j = 1; j <= grid_size_samples; j++) {
			vec2 uv = vec2(float(i), float(j)) / n;
			sum += texture(input, uv).rgb;
		}
	}

	vec3 avg = sum / float(grid_size_samples * grid_size_samples);
	COLOR = vec4(avg, 1);
}
"

[sub_resource type="ShaderMaterial" id="693"]
shader = SubResource("692")
shader_parameter/grid_size_samples = 48

