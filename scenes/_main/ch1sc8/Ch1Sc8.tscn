shader_parameter/opacity = 0.75

[sub_resource type="Shader" id="308"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform float strength : hint_range(0, 32) = 1.0;
uniform float inner_radius : hint_range(0, 1) = 0.2;
uniform float outer_radius : hint_range(0, 2) = 1.25;

void fragment() {
    vec2 centered = UV - vec2(0.5);
	float a = smoothstep(inner_radius, outer_radius, length(centered));
	COLOR = textureLod(SCREEN_TEXTURE, SCREEN_UV, a * strength);
}"

[sub_resource type="ShaderMaterial" id="309"]
shader = SubResource("308")
shader_parameter/strength = 0.0
shader_parameter/inner_radius = 0.2
shader_parameter/outer_radius = 1.25

[sub_resource type="ShaderMaterial" id="310"]
shader = ExtResource("1637")
shader_parameter/strength = 0.0
shader_parameter/glitch = 0.015

[sub_resource type="Shader" id="311"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform float strength : hint_range(0, 64) = 0;

void fragment() {
	vec2 uv = SCREEN_UV;
    vec4 color = texture(SCREEN_TEXTURE, uv);

    float x = (uv.x + 4.0) * (uv.y + 4.0) * (TIME * 10.0);
	vec4 grain = vec4(mod((mod(x, 13.0) + 1.0) * (mod(x, 123.0) + 1.0), 0.01) - 0.005) * strength;

	COLOR = color * grain;
}"

