uniform sampler2D SCREEN_TEXTURE: hint_screen_texture, filter_linear_mipmap;
uniform float contrast = 0.0;

uniform float step_fac = 0.92;
uniform float mult_strength = 1.2;
uniform float base_strength = 1.1;

void fragment() {
	COLOR = texture(texture_albedo, UV) * texture(SCREEN_TEXTURE, SCREEN_UV);
	float k = texture(texture_albedo, UV).r;

	if (k >= step_fac) {
		COLOR.rgb *= mult_strength * pow(k - step_fac, 1.5) + base_strength;
	} else {
		COLOR.rgb *= base_strength;
	}

	COLOR = clamp(COLOR, vec4(0), vec4(1));
}"

