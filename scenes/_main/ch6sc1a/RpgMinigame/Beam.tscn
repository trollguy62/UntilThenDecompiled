[sub_resource type="GDScript" id="GDScript_vnomg"]
script/source = "extends Node2D

@onready var arrowhead = $ArrowHead
@onready var debug_label = $CanvasLayer/Label

var anchor = Vector2()
var target = Vector2()

var _length: float = 0
var _t = 0
var _d_base_pos


func _ready():
	anchor = self.position
	_d_base_pos = arrowhead.position


func _process(delta):
	_t += delta
	_length = anchor.distance_to(arrowhead.global_position)
	arrowhead.position = sin(_t) * Vector2(25, 0) + _d_base_pos
	debug_label.rect_global_position = arrowhead.global_position + Vector2(10, 100)
	debug_label.text = str(_length)
	queue_redraw()


func _input(event):
	if event.is_action_pressed(\"ui_cancel\"):
		print(\"a\")
		print(_length)


func _draw():
	draw_circle(Vector2(), 5, Color.AQUA)
	draw_line(Vector2(), arrowhead.position, Color.AQUA, 5.0, false)
"

