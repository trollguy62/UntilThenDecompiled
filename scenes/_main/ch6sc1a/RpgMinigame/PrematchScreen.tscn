[sub_resource type="Shader" id="Shader_fxedm"]
code = "shader_type canvas_item;

uniform float dissolve : hint_range(0.0, 1.0) = 0.0;
uniform float frequency = 100.0;

void fragment() {
	COLOR.a = step(0.0, (cos(frequency * UV.y) + 1.0) / 2.0 - dissolve);
}
"

