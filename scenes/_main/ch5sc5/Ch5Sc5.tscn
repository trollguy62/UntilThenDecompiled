[sub_resource type="Shader" id="593"]
code = "shader_type spatial;

uniform sampler2D tex : filter_linear, repeat_disable;
uniform float y_fade_in : hint_range(0, 1) = 1.0;
uniform float alpha_mult : hint_range(0, 1) = 1.0;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	if (uv.x < 0. || uv.x > 1. || uv.y < 0. || uv.y > 1.)
		return vec4(0);

	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

void fragment() {
	vec2 px_size = 1.0 / vec2(textureSize(tex, 0));
	vec4 c = texturePointSmooth(tex, vec2(UV.x, (UV.y * 1.1 - 0.05) + sin((UV.x + TIME) * 6.0) * px_size.y * 0.1), px_size);
	float yi = 1. - y_fade_in;

	ALBEDO = c.rgb;
	ALPHA = c.a * alpha_mult
		* mix(0.5, 1.0, sin((UV.x + TIME * 0.5) * 4.0) * 0.5 + 0.5)
		* smoothstep(yi, yi + 0.2, UV.x);
}

"

