[sub_resource type="Shader" id="Shader_phjbh"]
code = "shader_type spatial;
render_mode depth_prepass_alpha, diffuse_burley, specular_schlick_ggx, cull_disabled;

uniform sampler2D texture_albedo : source_color, filter_linear;
uniform sampler2D texture_mask : filter_linear;
uniform float develop_fac : hint_range(0, 1) = 1.0;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

vec3 saturate(vec3 color, float amount) {
    vec3 gray = vec3(dot(vec3(0.2126, 0.7152, 0.0722), color));
    return clamp(vec3(mix(color, gray, 1.0 - amount)), vec3(0), vec3(1));
}

vec3 sepia(vec3 color) {
	return vec3(
		dot(color.rgb, vec3(0.393, 0.769, 0.189)),
    	dot(color.rgb, vec3(0.349, 0.686, 0.168)),
    	dot(color.rgb, vec3(0.272, 0.534, 0.131))
	);
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(texture_albedo, 0));
	vec4 albedo_tex = texturePointSmooth(texture_albedo, UV, px_size);
	
	float fac = mix(1.0, develop_fac, texturePointSmooth(texture_mask, UV, px_size).r);
	albedo_tex.rgb = saturate(albedo_tex.rgb, pow(fac, 2.0)); // Saturation
	albedo_tex.rgb = pow(albedo_tex.rgb, vec3(mix(0.02, 1.0, pow(fac, 4.0)))); // Contrast
	albedo_tex.rgb = mix(sepia(albedo_tex.rgb), albedo_tex.rgb, pow(fac, 3.0)); // Sepia

	ALBEDO = albedo_tex.rgb;
	ALPHA = albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = 1.0;
}
"

