[sub_resource type="Shader" id="Shader_g2dbg"]
code = "shader_type sky;

uniform sampler2D tex_base : source_color, filter_nearest;
uniform sampler2D tex_butterflies_mask : source_color, filter_nearest;
uniform sampler2D tex_butterflies_base : source_color, filter_nearest;

uniform float butterflies_heavenly : hint_range(0, 1) = 0.0;
uniform float butterflies_energy : hint_range(0, 32) = 4.0;

vec4 alphaComposite(vec4 Ca, vec4 Cb) {
	float a0 = Ca.a + (Cb.a * (1. - Ca.a));
	return (Ca * Ca.a + Cb * Cb.a * (1. - Ca.a)) / a0;
}

void sky() {
	float butterflies_mask = texture(tex_butterflies_mask, SKY_COORDS).r;

	vec4 butterflies = vec4(
		mix(
			texture(tex_butterflies_base, SKY_COORDS + vec2(TIME * 0.016)).rgb,
			vec3(1),
			butterflies_heavenly
		) * butterflies_energy,
		butterflies_mask * (cos(20.0 * (butterflies_mask + TIME * 0.1)) + 1.0) / 2.0
	);

	COLOR = alphaComposite(butterflies, texture(tex_base, SKY_COORDS)).rgb
		* smoothstep(0.65, 0.55, SKY_COORDS.y);
}
"

