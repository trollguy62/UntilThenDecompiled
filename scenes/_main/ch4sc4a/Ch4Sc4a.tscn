[sub_resource type="Shader" id="Shader_3yxj8"]
code = "shader_type canvas_item;

uniform sampler2D texture_display;

vec2 warp(vec2 uv){
	vec2 delta = uv - 0.5;
	float delta2 = dot(delta.xy, delta.xy);
	float delta4 = delta2 * delta2;
	float delta_offset = delta4 * 0.16;
	return uv + delta * delta_offset;
}

float vignette(vec2 uv) {
	return smoothstep(1.0, 0.45, distance(uv, vec2(0.5, 0.5)));
}

float scanlines(vec2 uv, float t) {
	float c = 0.5 * (sin(uv.y * 500. + t * 10.) + 1.);
	c = 1. - pow(c, 6.);
	c = 1. - (0.06 * (1. - c)) * 0.5;
	return c;
}

void fragment() {
	vec2 uv = warp(UV);
	COLOR = texture(texture_display, uv);
	COLOR.rgb *= vignette(UV) * scanlines(uv, TIME);
	COLOR.rgb *= 1.08;
}"

