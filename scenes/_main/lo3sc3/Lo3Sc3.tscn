[sub_resource type="Shader" id="Shader_dh22m"]
code = "shader_type canvas_item;

uniform sampler2D texture_albedo : source_color, filter_nearest, repeat_enable;

uniform float fluctuate_strength = 0.0;
uniform float fluctuate_speed = 1.0;

float R21(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 3758.5453123);
}

vec2 R22(vec2 st) {
	return vec2(R21(st * 0.7), R21(st * 0.3));
}

void fragment() {
	COLOR = texture(texture_albedo, UV + vec2(0, R21(UV)) * sin(32.0 * UV.x + TIME * fluctuate_speed) * fluctuate_strength);
}
"

