[sub_resource type="Shader" id="219"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0, 4) = 1.0;
uniform float reflection_exp : hint_range(0.01, 4) = 1.0;

const int kernelSampleCount = 22;
const highp vec2 kernel[22] = highp vec2[22] (
	vec2(0, 0),
	vec2(0.53333336, 0),
	vec2(0.3325279, 0.4169768),
	vec2(-0.11867785, 0.5199616),
	vec2(-0.48051673, 0.2314047),
	vec2(-0.48051673, -0.23140468),
	vec2(-0.11867763, -0.51996166),
	vec2(0.33252785, -0.4169769),
	vec2(1, 0),
	vec2(0.90096885, 0.43388376),
	vec2(0.6234898, 0.7818315),
	vec2(0.22252098, 0.9749279),
	vec2(-0.22252095, 0.9749279),
	vec2(-0.62349, 0.7818314),
	vec2(-0.90096885, 0.43388382),
	vec2(-1, 0),
	vec2(-0.90096885, -0.43388376),
	vec2(-0.6234896, -0.7818316),
	vec2(-0.22252055, -0.974928),
	vec2(0.2225215, -0.9749278),
	vec2(0.6234897, -0.7818316),
	vec2(0.90096885, -0.43388376)
);

void fragment() {
	if (strength < 0.001) {
		COLOR = texture(TEXTURE, UV);
	} else {
		vec2 size = 1.0 / vec2(textureSize(TEXTURE, 0));
		vec4 color = vec4(0);

		for (int i = 0; i < kernelSampleCount; i++) {
			vec2 o = kernel[i] * size * 8.0 * strength;
			color += texture(TEXTURE, UV + o);
		}

		color /= float(kernelSampleCount);
		COLOR = color;
	}

	COLOR.a *= pow(UV.x, reflection_exp);
}
"

[sub_resource type="ShaderMaterial" id="220"]
shader = SubResource("219")
shader_parameter/strength = 0.0
shader_parameter/reflection_exp = 1.05

[sub_resource type="Shader" id="214"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0, 4) = 1.0;

void fragment() {
	if (strength < 0.001) {
		COLOR = texture(TEXTURE, UV);
	} else {
		vec2 size = 1.0 / vec2(textureSize(TEXTURE, 0));
		vec4 o = size.xyxy * vec2(-0.5, 0.5).xxyy * strength;
		vec4 s =
				texture(TEXTURE, UV + o.xy) +
				texture(TEXTURE, UV + o.zy) +
				texture(TEXTURE, UV + o.xw) +
				texture(TEXTURE, UV + o.zw);
		COLOR = s * 0.25;
	}
}
"

