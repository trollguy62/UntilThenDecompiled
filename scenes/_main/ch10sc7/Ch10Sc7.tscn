[sub_resource type="Shader" id="Shader_l1luf"]
code = "shader_type spatial;
render_mode depth_draw_opaque, diffuse_burley, specular_schlick_ggx, cull_disabled;

uniform float power : hint_range(0., 1.) = 1.0;
uniform float metallic : hint_range(0., 1.) = 0.1;
uniform float roughness : hint_range(0., 1.) = 0.2;

uniform sampler2D tex_background : source_color;

float sin_bounded(float x, float a, float b) {
	float n = (b - a) / 2.;
	return n * sin(x) + n + a;
}

float scanline(float t, vec2 uv) {
	float c = 1. - pow(abs(0.5 - uv.y), power);
	c *= sin_bounded(t * 15. + uv.y * 200., 0.7, 1.0);
	return c;
}

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(tex_background, 0));
	vec2 uv = UV;

	vec4 bg = texturePointSmooth(tex_background, uv, px_size);
	float sl = scanline(TIME, uv);

	ALBEDO = bg.rgb * sl;
	EMISSION = bg.rgb * 1.5 * sl;

	METALLIC = metallic;
	ROUGHNESS = roughness;
}
"

