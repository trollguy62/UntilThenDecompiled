[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform float distortion = 1.0;
uniform float color_mult_min = 1.0;
uniform float color_mult_max = 1.05;
uniform sampler2D SCREEN_TEXTURE: hint_screen_texture, filter_linear_mipmap;

void fragment() {
	vec2 uv = SCREEN_UV;
	float d = distortion * 0.001;

	float r = texture(SCREEN_TEXTURE, vec2(uv.x - d, uv.y)).r;
	float g = texture(SCREEN_TEXTURE, vec2(uv.x, uv.y)).g;
	float b = texture(SCREEN_TEXTURE, vec2(uv.x + d, uv.y)).b;

	float n = (color_mult_max - color_mult_min) / 2.0;
	vec3 c = vec3(r, g, b) * ((n * sin(8.0 * TIME)) + n + color_mult_min);
	COLOR = vec4(c, 1.0);
}"

