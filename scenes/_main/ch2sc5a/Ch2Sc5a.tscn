[sub_resource type="Shader" id="158"]
code = "shader_type spatial;

uniform sampler2D display : source_color;
uniform float power : hint_range(0, 1) = 1.;

float sin_bounded(float x, float a, float b) {
	float n = (b - a) / 2.;
	return n * sin(x) + n + a;
}

void fragment() {
	vec4 tex = texture(display, vec2(UV.x, 2. - UV.y));

	float c = 1. - pow(abs(0.5 - UV.y), 1.2 * power);
	c *= sin_bounded(TIME * 10. + UV.y * 1000., 0.9, 1.0);

	ALBEDO = vec3(0.2 * power);
	EMISSION = pow(tex.rgb * c, vec3(1.2) );
//	ALBEDO = vec3(s);
}"

