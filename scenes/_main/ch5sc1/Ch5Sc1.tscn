[sub_resource type="Shader" id="5252"]
code = "shader_type spatial;
render_mode cull_disabled;

const float FRAMES = 4.0;

uniform float scale = 1.0;

uniform sampler2D variant_1 : source_color;
uniform sampler2D variant_2 : source_color;

uniform vec4 emission_color : source_color = vec4(1);
uniform float emission_strength : hint_range(0, 16) = 1.0;

varying flat float inst_id;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

vec2 variantTexSize(int id) {
	switch (id % 2) {
		case 0: return vec2(textureSize(variant_1, 0));
		case 1: return vec2(textureSize(variant_2, 0));
	}
}

vec4 variantTex(int id, vec2 uv, vec2 px_size) {
	switch (id % 2) {
		case 0: return texturePointSmooth(variant_1, uv, px_size);
		case 1: return texturePointSmooth(variant_2, uv, px_size);
	}
}

void vertex() {
	vec2 px_size = 1. / variantTexSize(INSTANCE_ID);
	inst_id = float(INSTANCE_ID);

	VERTEX -= vec3(0, 0.005, 0);
	VERTEX /= vec3(px_size.x * 4., px_size.y, 1.) / scale;
}

void fragment() {
	int id = int(inst_id);
	vec2 px_size = 1. / variantTexSize(id);
	vec2 uv = UV / vec2(FRAMES, 1) + vec2(mod(floor(TIME * 18.), FRAMES) / FRAMES, 0);
	vec4 tex = variantTex(id, uv, px_size);

	ALBEDO = tex.rgb * COLOR.rgb;
	ALPHA = tex.a * COLOR.a;
	EMISSION = emission_color.rgb * emission_color.a * emission_strength * pow(tex.r, 8.0);
}
"

