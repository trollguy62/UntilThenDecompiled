[sub_resource type="Shader" id="5317"]
code = "shader_type spatial;
render_mode depth_prepass_alpha, diffuse_burley, specular_schlick_ggx, cull_disabled;

uniform vec4 albedo : source_color = vec4(1.0f);
uniform sampler2D texture_albedo : source_color, repeat_disable;
uniform float alpha_scissor : hint_range(0, 1) = 1.0f;

uniform sampler2D texture_albedo_l0 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l1 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l2 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l3 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l4 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l5 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l6 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l7 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l8 : source_color, repeat_disable;
uniform sampler2D texture_albedo_l9 : source_color, repeat_disable;

uniform vec4 offset_l0;
uniform vec4 offset_l1;
uniform vec4 offset_l2;
uniform vec4 offset_l3;
uniform vec4 offset_l4;
uniform vec4 offset_l5;
uniform vec4 offset_l6;
uniform vec4 offset_l7;
uniform vec4 offset_l8;
uniform vec4 offset_l9;

uniform sampler2D texture_normal : hint_normal, repeat_disable;

uniform float normal_depth = 1.0f;
uniform bool normal_linear_sampling = false;

uniform float metallic : hint_range(0, 1) = 0.0f;
uniform float roughness : hint_range(0, 1) = 1.0f;
uniform float specular : hint_range(0, 1) = 0.5f;
uniform sampler2D texture_roughness_metallic : hint_default_white, repeat_disable;

uniform vec4 emission : source_color = vec4(0, 0, 0, 1);
uniform float emission_energy : hint_range(0, 16) = 1.0f;
uniform float emission_saturation : hint_range(0, 8) = 1.0f;
uniform sampler2D texture_emission : hint_default_black, repeat_disable;
uniform bool emission_blend_add = true;

uniform sampler2D texture_wet : hint_default_black, repeat_disable;
uniform sampler2D texture_wet_normal : repeat_disable;
uniform float wet_metallic : hint_range(0, 1) = 0.5;

vec4 texturePointSmooth(sampler2D smp, vec2 uv, vec2 pixel_size) {
	vec2 ddx = dFdx(uv);
	vec2 ddy = dFdy(uv);
	vec2 lxy = sqrt(ddx * ddx + ddy * ddy);

	vec2 uv_pixels = uv / pixel_size;
	vec2 uv_pixels_floor = round(uv_pixels) - vec2(0.5f);
	vec2 uv_dxy_pixels = uv_pixels - uv_pixels_floor;

	uv_dxy_pixels = clamp((uv_dxy_pixels - vec2(0.5f)) * pixel_size / lxy + vec2(0.5f), 0.0f, 1.0f);
	uv = uv_pixels_floor * pixel_size;
	return textureGrad(smp, uv + uv_dxy_pixels * pixel_size, ddx, ddy);
}

vec3 saturate(vec3 color, float amount) {
    vec3 gray = vec3(dot(vec3(0.2126, 0.7152, 0.0722), color));
    return clamp(vec3(mix(color, gray, 1.0 - amount)), vec3(0), vec3(1));
}

vec2 layerPxSize(int layer) {
	switch (layer % 10) {
		case 0: return 1.0 / vec2(textureSize(texture_albedo_l0, 0));
		case 1: return 1.0 / vec2(textureSize(texture_albedo_l1, 0));
		case 2: return 1.0 / vec2(textureSize(texture_albedo_l2, 0));
		case 3: return 1.0 / vec2(textureSize(texture_albedo_l3, 0));
		case 4: return 1.0 / vec2(textureSize(texture_albedo_l4, 0));
		case 5: return 1.0 / vec2(textureSize(texture_albedo_l5, 0));
		case 6: return 1.0 / vec2(textureSize(texture_albedo_l6, 0));
		case 7: return 1.0 / vec2(textureSize(texture_albedo_l7, 0));
		case 8: return 1.0 / vec2(textureSize(texture_albedo_l8, 0));
		case 9: return 1.0 / vec2(textureSize(texture_albedo_l9, 0));
	}
}

vec4 layerOffset(int layer) {
	switch (layer % 10) {
		case 0: return offset_l0;
		case 1: return offset_l1;
		case 2: return offset_l2;
		case 3: return offset_l3;
		case 4: return offset_l4;
		case 5: return offset_l5;
		case 6: return offset_l6;
		case 7: return offset_l7;
		case 8: return offset_l8;
		case 9: return offset_l9;
	}
}

vec4 layerTex(int layer, vec2 base_uv, vec2 extra_offset, vec2 parent_px_size) {
	vec2 px_size = layerPxSize(layer);
	vec4 lo = layerOffset(layer);
	vec2 uv = (base_uv - (extra_offset * lo.zw) - (lo.xy * parent_px_size)) * (px_size / parent_px_size);

	if (layer > 0 && (uv.x < 0. || uv.x > 1. || uv.y < 0. || uv.y > 1.)) {
		return vec4(0);
	}

	switch (layer % 10) {
		case 0: return texturePointSmooth(texture_albedo_l0, uv, px_size);
		case 1: return texturePointSmooth(texture_albedo_l1, uv, px_size);
		case 2: return texturePointSmooth(texture_albedo_l2, uv, px_size);
		case 3: return texturePointSmooth(texture_albedo_l3, uv, px_size);
		case 4: return texturePointSmooth(texture_albedo_l4, uv, px_size);
		case 5: return texturePointSmooth(texture_albedo_l5, uv, px_size);
		case 6: return texturePointSmooth(texture_albedo_l6, uv, px_size);
		case 7: return texturePointSmooth(texture_albedo_l7, uv, px_size);
		case 8: return texturePointSmooth(texture_albedo_l8, uv, px_size);
		case 9: return texturePointSmooth(texture_albedo_l9, uv, px_size);
	}
}

void fragment() {
	vec2 px_size = 1.0f / vec2(textureSize(texture_albedo, 0));

	vec4 albedo_tex = texturePointSmooth(texture_albedo, UV, px_size);
	vec4 wet_tex = texturePointSmooth(texture_wet, UV, px_size);

	if (albedo_tex.g < 0.95) {
		ALBEDO = albedo.rgb * albedo_tex.rgb * mix(0.5, 1., 1. - wet_tex.g);
	} else {
		vec3 cam_dist = (INV_VIEW_MATRIX[3] - MODEL_MATRIX[3]).xyz + vec3(24.0, 0, 0);
		vec2 parallax_offset = vec2(0.01 * -cam_dist.x, sin(TIME * 0.8) * 0.004);

		vec3 albedo_layers = vec3(0);

		for (int i = 0; i < 10; i++) {
			vec4 tex = layerTex(i, UV, parallax_offset, px_size);
			albedo_layers = albedo_layers * (1. - tex.a) + tex.rgb * tex.a;
		}

		ALBEDO = albedo_layers;
	}

	ALPHA = albedo.a * albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor;

	vec2 roughness_metallic_tex = texturePointSmooth(texture_roughness_metallic, UV, px_size).rg;
	ROUGHNESS = roughness_metallic_tex.r * roughness * (1. - wet_tex.r);
	METALLIC = mix(roughness_metallic_tex.g * metallic, wet_metallic, wet_tex.r);

	vec3 normal_tex = texturePointSmooth(texture_normal, UV, px_size).rgb;
	vec3 normal_wet_tex = texturePointSmooth(texture_wet_normal, UV + vec2(TIME * 0.005), px_size).rgb;

	NORMAL_MAP = mix(normal_tex, normal_wet_tex, wet_tex.g);
	NORMAL_MAP_DEPTH = mix(normal_depth, 1.0, wet_tex.g);
	SPECULAR = specular;

	vec4 emission_tex = texturePointSmooth(texture_emission, UV, px_size);

	vec3 emission_c1 = emission_tex.rgb * emission_tex.a;
	vec3 emission_c2 = emission.rgb * emission.a;
	vec3 emission_all = emission_blend_add ? emission_c1 + emission_c2 : emission_c1 * emission_c2;
	emission_all = saturate(emission_all, emission_saturation);

	EMISSION = emission_all * emission_energy;
}
"

