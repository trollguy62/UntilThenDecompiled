[sub_resource type="Shader" id="3627"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform float blur : hint_range(0, 8) = 2.0;
uniform float brightness : hint_range(0, 1) = 0.5;


void fragment() {
	COLOR.rgb = textureLod(SCREEN_TEXTURE, SCREEN_UV, blur).rgb * brightness;
}"

