; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Until Then"
run/main_scene="res://components/GameLauncher/GameLauncher.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.1", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://assets/meta/icon.png"
config/windows_native_icon="res://assets/meta/icon.ico"
config/version="git.7524c18ceaf"

[autoload]

Constants="*res://Constants.gd"
Index="*res://Index.gd"
Service="*res://Service.gd"
Game="*res://Game.gd"
Utils="*res://Utils.gd"
Store="*res://Store.gd"
Story="*res://data/story/Story.gd"
CameraManager="*res://components/CameraManager.gd"
WebUtils="*res://data/web/WebUtils.gd"
FbUtils="*res://data/fb/FbUtils.gd"
PauseScreen="*res://ui/screens/Game/PauseScreen/PauseScreen.tscn"
FocusManager="*res://components/FocusManager.gd"
DebugConsoleScreen="*res://ui/screens/Game/DebugConsoleScreen/DebugConsoleScreen.tscn"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"
StatsMonitor="*res://components/StatsMonitor/StatsMonitor.tscn"
AudioUtils="*res://components/AudioUtils.gd"
StudioManager="*res://components/audio/StudioManager.gd"
FMODRuntime="*res://addons/fmod/runtime/fmod_runtime_manager.gd"
InputLoader="*res://InputLoader.gd"
EnvironmentManager="*res://components/EnvironmentManager.gd"
RecordReplay="*res://modules/record-replay/RecordReplay.tscn"

[debug]

gdscript/warnings/native_method_override=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://assets/ui/cursors/pointer.png"

[dotnet]

project/assembly_name="Until Then"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg", "res://addons/record-replay/plugin.cfg")

[fmod]

settings/banks_path="res://assets/soundbanks/Desktop"
settings/fmod_output_type=0
settings/fmod_debug_flags=0
settings/fmod_debug_mode=1
settings/banks_to_load_at_startup=["res://assets/soundbanks/Desktop/Master.bank", "res://assets/soundbanks/Desktop/Master.strings.bank"]
settings/banks_preload_samples=false
settings/banks_flags=0
settings/sample_rate=48000
settings/speaker_mode=3
settings/dsp_buffer_length=512
settings/dsp_buffer_count=4
settings/real_channel_count=32
settings/virtual_channel_count=128
settings/enable_live_update=true
settings/live_update_port=9264
settings/enable_memory_tracking=false
settings/encryption_key=""
settings/distance_scale_2d=1.0
settings/init_with_3d_righthanded=true

[importer_defaults]

texture={
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}
wavefront_obj={
"generate_tangents": true,
"offset_mesh": Vector3(0, 0, 0),
"optimize_mesh": false,
"scale_mesh": Vector3(1, 1, 1)
}
2d_array_texture={
"compress/mode": 0
}
3d_texture={
"compress/mode": 0
}

