[internationalization]

locale/translation_remaps={
"res://fonts/DiarioDeAndy-Extended-Ligatures-removed.ttf": PackedStringArray("res://fonts/locales/ja/KosugiMaru-Regular.ttf:ja_JP", "res://fonts/locales/zh_CN/NotoSansSC-Regular.ttf:zh_CN")
}
locale/translations=PackedStringArray("res://assets/locales/text.en.translation", "res://assets/locales/text.de.translation", "res://assets/locales/text.es.translation", "res://assets/locales/text.fr.translation", "res://assets/locales/text.it.translation", "res://assets/locales/text.zh_CN.translation", "res://assets/locales/text.ja.translation", "res://assets/locales/text.fil.translation", "res://assets/locales/text.id.translation")

[memory]

limits/message_queue/max_size_mb=64

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=2
environment/ssao/half_size=false
textures/decals/filter=0
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
quality/godrays/sample_number=30
quality/godrays/use_pcf5=true
quality/godrays/dither_amount=1.0

[shader_globals]

wet_tex_distort={
"type": "sampler2D",
"value": "res://assets/shaders/WetTexDistort.tres"
}
wet_tex_ripple={
"type": "sampler2D",
"value": "res://scenes/_main/ch1sc8/assets/rain_ripples_n.png"
}
rain_level={
"type": "float",
"value": 0.0
}
