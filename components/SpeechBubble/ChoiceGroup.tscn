[sub_resource type="Shader" id="7"]
code = "shader_type canvas_item;

uniform float value : hint_range(0, 1) = 1.0;

float circle(float r, vec2 uv) {
	return smoothstep(r, r - 0.02, length(uv - vec2(0.5)));
}

float atan2(vec2 v) {
    float x = v.x == 0.0 ? sign(v.y)*PI/2. : atan(v.y, v.x);
	return x > 0. ? x : 2.*PI + x;
}

void fragment() {
	float c = circle(0.5, UV);
	c *= 1.0 - circle(0.35, UV);
	float t = mod(-atan2(UV - vec2(0.5)) - (PI / 2.), 2.*PI) / (2.*PI);
	t = step(t, value);
	c *= t;
	COLOR = vec4(c);
}"

