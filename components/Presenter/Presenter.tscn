[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE: hint_screen_texture;

uniform float blur : hint_range(0, 8) = 2.0;
uniform float brightness : hint_range(0, 1) = 0.5;
uniform vec4 modulate : source_color = vec4(0);

void fragment() {
	vec4 c = textureLod(SCREEN_TEXTURE, SCREEN_UV, blur);
	COLOR = vec4(c.rgb * brightness, c.a) * modulate;
}"

