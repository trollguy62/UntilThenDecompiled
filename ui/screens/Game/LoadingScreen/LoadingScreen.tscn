[sub_resource type="Shader" id="2"]
code = "shader_type canvas_item;

uniform float frame_width : hint_range(0.01, 0.5) = 0.1;

vec2 rotateUV(vec2 uv, float rotation, float mid) {
	return vec2(
	    cos(rotation) * (uv.x - mid) + sin(rotation) * (uv.y - mid) + mid,
	    cos(rotation) * (uv.y - mid) - sin(rotation) * (uv.x - mid) + mid
	);
}

float hand(vec2 uv, float w, float l) {
	float x = 0.5 - (w / 2.);
	float aa = 0.02;
	return
		smoothstep(x - aa, x, uv.x) * smoothstep(x - aa, x, 1. - uv.x) *
		step(0.5, 1. - uv.y) * smoothstep(0.5 - l - aa, 0.5 - l, uv.y);
}

float circle(float r, float distc) {
	return smoothstep(r, r - 0.02, distc);
}

void fragment() {
	vec2 uvc = UV - vec2(0.5);
	float distc = length(uvc);

	float frame_outer = circle(0.5, distc);
	float frame_inner = circle(0.5 - frame_width, distc);
	float frame = abs(frame_outer - frame_inner);
	float axle = circle(0.06, distc);

	float t = TIME * 2. * PI;
	float hour_hand = hand(rotateUV(UV, t / 12.0, 0.5), 0.035, 0.18);
	float minute_hand = hand(rotateUV(UV, t, 0.5), 0.035, 0.35);

	float c = frame + axle + hour_hand + minute_hand;
	c = clamp(c, 0, 1);
	COLOR = vec4(vec3(c), 1);
}"

