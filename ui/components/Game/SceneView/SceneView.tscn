[sub_resource type="Shader" id="2"]
code = "shader_type canvas_item;

uniform sampler2D tex : filter_linear_mipmap;
uniform float blur : hint_range(0.0, 8.0) = 0.0;
uniform float dark : hint_range(0.0, 1.0) = 1.0;
uniform bool enabled = false;
uniform vec4 modulate = vec4(1.0);

void fragment() {
	if (enabled) {
		vec4 t = textureLod(tex, UV, blur);
		float c = (t.r + t.g + t.b) / 3.0 * dark;
		COLOR = vec4(vec3(c), 1.0) * modulate;
	} else{
		COLOR = texture(tex, UV) * modulate;
	}
}"

