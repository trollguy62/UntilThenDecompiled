[configuration]
entry_symbol = "threen_library_init"
compatibility_minimum = 4.1

[libraries]
linux.editor = "res://addons/threen/linux/libthreen.editor.so"
linux.debug = "res://addons/threen/linux/libthreen.debug.so"
linux.release = "res://addons/threen/linux/libthreen.so"
windows.editor = "res://addons/threen/windows/threen.editor.dll"
windows.debug = "res://addons/threen/windows/threen.debug.dll"
windows.release = "res://addons/threen/windows/threen.dll"
macos.editor = "res://addons/threen/macos/libthreen.editor.dylib"
macos.debug = "res://addons/threen/macos/libthreen.debug.dylib"
macos.release = "res://addons/threen/macos/libthreen.dylib"
