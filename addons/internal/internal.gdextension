[configuration]
entry_symbol = "internal_library_init"
compatibility_minimum = 4.1

[libraries]
linux.editor = "res://addons/internal/linux/libinternal.editor.so"
linux.debug = "res://addons/internal/linux/libinternal.debug.so"
linux.release = "res://addons/internal/linux/libinternal.so"
windows.editor = "res://addons/internal/windows/internal.editor.dll"
windows.debug = "res://addons/internal/windows/internal.debug.dll"
windows.release = "res://addons/internal/windows/internal.dll"
macos.editor = "res://addons/internal/macos/libinternal.editor.dylib"
macos.debug = "res://addons/internal/macos/libinternal.debug.dylib"
macos.release = "res://addons/internal/macos/libinternal.dylib"
