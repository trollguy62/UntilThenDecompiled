[configuration]
entry_symbol = "inkcpp_library_init"
compatibility_minimum = 4.1

[libraries]
linux.editor = "res://addons/inkcpp/linux/libinkcpp.editor.so"
linux.debug = "res://addons/inkcpp/linux/libinkcpp.debug.so"
linux.release = "res://addons/inkcpp/linux/libinkcpp.so"
windows.editor = "res://addons/inkcpp/windows/inkcpp.editor.dll"
windows.debug = "res://addons/inkcpp/windows/inkcpp.debug.dll"
windows.release = "res://addons/inkcpp/windows/inkcpp.dll"
macos.editor = "res://addons/inkcpp/macos/libinkcpp.editor.dylib"
macos.debug = "res://addons/inkcpp/macos/libinkcpp.debug.dylib"
macos.release = "res://addons/inkcpp/macos/libinkcpp.dylib"
