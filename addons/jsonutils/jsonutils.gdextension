[configuration]
entry_symbol = "jsonutils_library_init"
compatibility_minimum = 4.1

[libraries]
linux.editor = "res://addons/jsonutils/linux/libjsonutils.editor.so"
linux.debug = "res://addons/jsonutils/linux/libjsonutils.debug.so"
linux.release = "res://addons/jsonutils/linux/libjsonutils.so"
windows.editor = "res://addons/jsonutils/windows/jsonutils.editor.dll"
windows.debug = "res://addons/jsonutils/windows/jsonutils.debug.dll"
windows.release = "res://addons/jsonutils/windows/jsonutils.dll"
macos.editor = "res://addons/jsonutils/macos/libjsonutils.editor.dylib"
macos.debug = "res://addons/jsonutils/macos/libjsonutils.debug.dylib"
macos.release = "res://addons/jsonutils/macos/libjsonutils.dylib"
